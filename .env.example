# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placement_portal
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_POOL_SIZE=10

# Application Server Configuration
PORT=8080
APP_ENV=development
APP_SECRET=university-super-secret-jwt-and-session-salt-2026

# Default Initial Administrator Configuration (used by AppContextListener on first start)
INITIAL_ADMIN_EMAIL=admin@placement.edu
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME=Placement Administrator

# Upload Configuration
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5

